# ── InfoExplorer Agent — Environment Configuration ────────────────────────────
# Copy this file to .env, then run: ./run.sh setup
# setup generates the SearXNG secret key and starts all services automatically.

# ── Ollama ────────────────────────────────────────────────────────────────────
# Ollama must be running natively on the host machine (not in Docker).
# Default works for Docker Desktop (Mac/Windows). On Linux use: http://172.17.0.1:11434
OLLAMA_URL=http://host.docker.internal:11434

# ── Reports output directory ──────────────────────────────────────────────────
# Path on the HOST machine where research reports are saved.
REPORTS_DIR=./reports

# ── Dashboard port ────────────────────────────────────────────────────────────
# The InfoExplorer dashboard will be available at http://localhost:<RESEARCH_PORT>
RESEARCH_PORT=8888

# ── Auto-run on container start ───────────────────────────────────────────────
# Set to true to trigger a research run immediately when the container starts.
RUN_ON_START=false

# ── Search provider ──────────────────────────────────────────────────────────
# Choose search backend: 'searxng' (default, self-hosted) or 'tavily' (API).
# When set to 'tavily', falls back to SearXNG if Tavily returns no results.
# SEARCH_PROVIDER=searxng

# Tavily API key — required when SEARCH_PROVIDER=tavily
# Get a free key at https://app.tavily.com (1,000 credits/month)
# TAVILY_API_KEY=tvly-YOUR_API_KEY

# ── Future agent ports (uncomment when adding new agents) ─────────────────────
# COMPLIANCE_PORT=8889
# THREAT_PORT=8890
